{
  "name": "qinghe-people",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4318 --configLoader native",
    "build": "vue-tsc --noEmit && vite build --configLoader native",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/local-data.test.mjs tests/data-source.test.mjs",
    "check": "npm run build && npm test && npm run test:runtime",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:runtime": "node --test tests/runtime.test.mjs",
    "audit:release": "node scripts/audit-release.mjs"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "playwright-core": "^1.63.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vue-tsc": "^3.1.1"
  }
}
